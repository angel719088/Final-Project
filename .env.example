# 複製此檔為 .env 後填入實際值。請勿將 .env 提交到版本控制。

# ---------- Backend ----------
APP_ENV=development
DATABASE_URL=sqlite:///./app.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI Provider：mock | openai | anthropic
# 未填 API Key 時會自動退回 mock
AI_PROVIDER=mock

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---------- Frontend（只有 VITE_ 開頭的變數會暴露給前端，切勿放 Key） ----------
# 預設 /api：開發時經由 Vite proxy 轉發到後端（同源，不需 CORS）
# 若改為直接呼叫後端（例如 http://localhost:8000/api），請確認來源已列在 CORS_ORIGINS
VITE_API_BASE_URL=/api
# Vite dev server 的 proxy 目標（不會暴露給瀏覽器）
API_PROXY_TARGET=http://localhost:8000
